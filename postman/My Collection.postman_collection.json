		{
			"name": "Crear Servicio",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"console.log(\"Respuesta de servicios:\", jsonData);",
							"",
							"// Obtiene el objeto interno 'servicio' o usa la raíz si viene plano",
							"var servicioObj = jsonData.servicio || jsonData;",
							"",
							"// Busca la clave del ID (incluyendo serviciosID plural)",
							"var id = servicioObj.serviciosID || servicioObj.servicioID || servicioObj.id || servicioObj._id;",
							"",
							"if (id) {",
							"    pm.environment.set(\"servicioID\", id);",
							"    console.log(\"servicioID guardado con éxito: \" + id);",
							"} else {",
							"    console.log(\"⚠️ No se pudo extraer el ID. Estructura:\", JSON.stringify(jsonData));",
							"}"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{token}}",
							"type": "string"
						}
					]
				},
