		{
			"name": "Crear Barbero",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"var id = jsonData.barberoID || (jsonData.barbero && (jsonData.barbero.barberoID || jsonData.barbero.id)) || jsonData.id;",
							"if (id) {",
							"    pm.environment.set(\"barberoID\", id);",
							"    console.log(\"barberoID guardado con éxito: \" + id);",
							"} else {",
							"    console.log(\"⚠️ No se encontró el barberoID en la respuesta:\", jsonData);",
							"}"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"usuarioID\": {{usuarioID}},\n  \"comision\": 20.0,\n  \"activo\": true\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
